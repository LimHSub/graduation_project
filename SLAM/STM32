static inline void MOTOR_SPEED_STOP_ALL(void)
{
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 0); // M1 PWM
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0); // M2 PWM
}

// 너가 경험했던 “반전” 유지 (필요없으면 out=duty로 바꾸면 됨)
static inline void MOTOR_SPEED_DUTY_ALL(float duty)
{
    if (duty < 0.0f) duty = 0.0f;
    if (duty > 100.0f) duty = 100.0f;

    float out = 100.0f - duty;   // ✅ 반전 보정(유지)

    PWM_SetDuty_TIM2_CH2(out);   // Motor1
    PWM_SetDuty_TIM2_CH1(out);   // Motor2
}

static void Encoder_All_Start(void)
{
    HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL); // ENC1 (TIM4)
    HAL_TIM_Encoder_Start(&htim3, TIM_CHANNEL_ALL); // ENC2 (TIM3)

    enc1_prev = (int32_t)__HAL_TIM_GET_COUNTER(&htim4);
    enc2_prev = (int32_t)__HAL_TIM_GET_COUNTER(&htim3);
}

static int16_t Encoder1_ReadDelta(void)
{
    int32_t now = (int32_t)__HAL_TIM_GET_COUNTER(&htim4);
    int16_t d = (int16_t)(now - enc1_prev);
    enc1_prev = now;
    return (int16_t)(ENC1_SIGN * d);
}

static int16_t Encoder2_ReadDelta(void)
{
    int32_t now = (int32_t)__HAL_TIM_GET_COUNTER(&htim3);
    int16_t d = (int16_t)(now - enc2_prev);
    enc2_prev = now;
    return (int16_t)(ENC2_SIGN * d);
}

static inline uint8_t imu_checksum_ok(const uint8_t *f)
{
    uint8_t sum = 0;
    for (int i = 0; i < 10; i++) sum += f[i];
    return (sum == f[10]);
}

/* 0x55 0x52(gyro), 0x55 0x53(angle) 프레임 파싱 */
static void imu_parse_frame(const uint8_t *f)
{
    if (!imu_checksum_ok(f)) return;

    if (f[1] == 0x52) { // gyro
        int16_t gz_raw = (int16_t)((f[7] << 8) | f[6]); // little-endian
        // 보통 ±2000 dps: raw/32768*2000
        imu_gz_dps = (float)gz_raw * 2000.0f / 32768.0f;
    }
    else if (f[1] == 0x53) { // angle
        int16_t yaw_raw = (int16_t)((f[7] << 8) | f[6]);
        float yaw = (float)yaw_raw * 180.0f / 32768.0f;  // [-180,180] 근처

        if (!imu_yaw0_set) { imu_yaw0_deg = yaw; imu_yaw0_set = 1; }
        imu_yaw_deg = yaw - imu_yaw0_deg;   // 상대 yaw (원하면 그냥 yaw로 바꿔도 됨)
    }
}

static inline float clampf(float v, float lo, float hi){
  if(v<lo) return lo;
  if(v>hi) return hi;
  return v;
}

// duty1: Motor1(TIM2_CH2), duty2: Motor2(TIM2_CH1)
static inline void MOTOR_SPEED_DUTY_LR(float duty1, float duty2)
{
    duty1 = clampf(duty1, 0.0f, 100.0f);
    duty2 = clampf(duty2, 0.0f, 100.0f);

    if (duty1 <= 0.0f) {
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 0);  // ✅ 진짜 OFF
    } else {
        PWM_SetDuty_TIM2_CH2(100.0f - duty1);             // ✅ 인버팅 보정
    }

    if (duty2 <= 0.0f) {
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0);  // ✅ 진짜 OFF
    } else {
        PWM_SetDuty_TIM2_CH1(100.0f - duty2);
    }
}



static void AdjustMotorsByYaw50ms(void)
{
    if(!straight_active || !yaw_ref_set) return;

    float err = yaw_ref - imu_yaw_deg ;

    if (err > 180.0f) err -= 360.0f;
    if (err < -180.0f) err += 360.0f;

    if (fabsf(err) < YAW_DEADBAND_DEG) err = 0.0f;

    float corr = Kp_YAW * err;
    corr = clampf(corr, -CORR_MAX, +CORR_MAX);

    if(is_reverse) corr = -corr;

    float dutyL = base_duty - corr;
    float dutyR = base_duty + corr;

    MOTOR_SPEED_DUTY_LR(dutyL, dutyR);
}


