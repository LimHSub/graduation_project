void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
	if (huart->Instance == USART3)
	{
	    char c = (char)rx3;

	    if (c == '\r') {
	        // 무시(윈도우 CRLF 대비)
	    }
	    else if (c == '\n') {
	        // 한 줄 끝
	        rx3_line[rx3_idx] = '\0';
	        rx3_idx = 0;

	        // "L R" 또는 "L,R" 둘 다 허용하고 싶으면 콤마를 공백으로 바꿔줌
	        for (int i = 0; rx3_line[i]; i++) {
	            if (rx3_line[i] == ',') rx3_line[i] = ' ';
	        }

	        int l, r;
            if (sscanf(rx3_line, "%d %d", &l, &r) == 2) {
                cmd_duty_L = clamp_cmd_signed(l);
                cmd_duty_R = clamp_cmd_signed(r);
                speed_updated = 1;
            }
	        // 파싱 실패하면 그냥 무시
	    }
	    else {
	        // 버퍼에 쌓기
	        if (rx3_idx < RX3_LINE_MAX - 1) {
	            rx3_line[rx3_idx++] = c;
	        } else {
	            // overflow -> 리셋
	            rx3_idx = 0;
	        }
	    }

	    HAL_UART_Receive_IT(&huart3, &rx3, 1);
	}

    else if (huart->Instance == USART2)
    {
        uint8_t b = imu_rx;

        if (!imu_sync)
        {
            if (b == 0x55) {
                imu_sync = 1;
                imu_idx = 0;
                imu_buf[imu_idx++] = b;
            }
        }
        else
        {
            imu_buf[imu_idx++] = b;

            if (imu_idx >= IMU_FRAME_LEN)
            {
                imu_parse_frame(imu_buf);
                imu_sync = 0;
                imu_idx = 0;
            }
        }

        // ✅ 이 줄이 없으면 IMU는 “1바이트 받고 끝”
        HAL_UART_Receive_IT(&huart2, &imu_rx, 1);
    }
}




void PWM_SetDuty_TIM2_CH2(float duty_percent)
{
    if (duty_percent < 0.0f) duty_percent = 0.0f;
    if (duty_percent > 100.0f) duty_percent = 100.0f;

    uint32_t arr = __HAL_TIM_GET_AUTORELOAD(&htim2);
    uint32_t ccr = (uint32_t)((duty_percent / 100.0f) * (arr + 1));
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, ccr);
}

