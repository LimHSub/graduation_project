/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  MX_USART3_UART_Init();
  MX_TIM4_Init();
  MX_TIM3_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */

  ////* MOTOR Setting STRAT*////
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);
  MOTOR_SPEED_STOP_ALL();
  MOTOR_STOP_ALL();
  HAL_Delay(200);
  ////* MOTOR Setting END*////

  HAL_UART_Receive_IT(&huart3, &rx3, 1);
  HAL_UART_Receive_IT(&huart2, &imu_rx, 1);

  Encoder_All_Start();
  last_upd_ms  = HAL_GetTick();
  last_send_ms = last_upd_ms;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  uint32_t now_ms = HAL_GetTick();

	  if (speed_updated)
	  {
	      speed_updated = 0;

	      int16_t L = cmd_duty_L;
	      int16_t R = cmd_duty_R;

	      // (1) 둘 다 0이면 정지: START 먼저 끄는 순서 OK
	      if (L == 0 && R == 0)
	      {
	          MOTOR_STOP_ALL();
	          HAL_Delay(20);
	          MOTOR_SPEED_STOP_ALL();

	          straight_active = 0;
	          yaw_ref_set = 0;
	      }
	      // 직진일때
	      else if(L == R && L != 0){
	    	    if (L > 0) {
	    	        M1_DIR_FWD();
	    	        M2_DIR_FWD();
	    	        is_reverse = 0;
	    	    } else {
	    	        M1_DIR_REV();
	    	        M2_DIR_REV();
	    	        is_reverse = 1;
	    	    }

	    	    MOTOR_START_ALL();

	    	    base_duty = (float)((L > 0) ? L : -L);

	    	    if(!yaw_ref_set){
		    	    yaw_ref = imu_yaw_deg;
		    	    yaw_ref_set = 1;
	    	    }

	    	    straight_active = 1;

	    	    //MOTOR_SPEED_DUTY_LR(base_duty, base_duty);
	      }
	      // 회전할때
	      else
	      {
	          straight_active = 0;
	          yaw_ref_set = 0;

	          // (2) 방향 설정: 부호로 DIR 결정 (PWM은 abs로)
	          if (L >= 0) M1_DIR_FWD(); else M1_DIR_REV();
	          if (R >= 0) M2_DIR_FWD(); else M2_DIR_REV();

	          // (3) enable(start) 제어
	          if (L == 0 && R != 0) {
	              MOTOR_START_RIGHT();   // 오른쪽만 enable
	          } else if (R == 0 && L != 0) {
	              MOTOR_START_LEFT();    // 왼쪽만 enable
	          } else {
	              MOTOR_START_ALL();     // 둘 다 enable
	          }

	          // (4) PWM은 절댓값으로
	          float dutyL = (float)((L >= 0) ? L : -L);
	          float dutyR = (float)((R >= 0) ? R : -R);

	          MOTOR_SPEED_DUTY_LR(dutyL, dutyR);
	      }

	      // yaw 보정 안 쓰면 그대로 OFF
	      //straight_active = 0;
	      //yaw_ref_set = 0;
	  }




	  /* (1) 엔코더 raw 누적: 1~5ms 주기로 자주 */
	  if (now_ms - last_upd_ms >= ENC_UPD_MS)
	  {
	      last_upd_ms = now_ms;

	      acc1_raw += (int32_t)Encoder1_ReadDelta();
	      acc2_raw += (int32_t)Encoder2_ReadDelta();
	  }

	  /* (2) UART로는 50ms마다만 전송 */
	  if (now_ms - last_send_ms >= ENC_SEND_MS)
	  {
	      last_send_ms = now_ms;
	      AdjustMotorsByYaw50ms();

	      int32_t p1 = (acc1_raw >> ENC_SHIFT);
	      int32_t p2 = (acc2_raw >> ENC_SHIFT);

	      //int32_t c3 = (int32_t)__HAL_TIM_GET_COUNTER(&htim3);
	      //int32_t c4 = (int32_t)__HAL_TIM_GET_COUNTER(&htim4);

	      char buf[160];


	      int n = snprintf(buf, sizeof(buf),
	                       "%ld, %ld, %.2f, %.2f\r\n",
	                       (long)p1, (long)p2,
	                       (double)imu_yaw_deg, (double)imu_gz_dps);



	      HAL_UART_Transmit(&huart3, (uint8_t*)buf, n, 50);
	  }


  }
  /* USER CODE END 3 */
}

