static inline int16_t clamp_cmd_signed(int v)
{
    if (v == 0) return 0;

    if (v > 0) {
        if (v < 3)  v = 3;
        if (v > 50) v = 50;
        return (int16_t)v;
    } else { // v < 0
        // -1 ~ -4 를 -5로
        if (v > -3)  v = -3;
        if (v < -50) v = -50;
        return (int16_t)v;
    }
}

